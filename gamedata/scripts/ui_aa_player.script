--- ui_aa_player: audition the soundscape for curation (PageUp, MCM gate); browse channels or a loaded playlist.

local table_sort, string_format, table_concat = table.sort, string.format, table.concat
local string_gmatch, tostring = string.gmatch, tostring
local RegisterScriptCallback = RegisterScriptCallback

local NOTES_FILE = "alifeambience_notes.txt"
local PGUP_KEY   = 201
local STAGE_ROOT = "stage"
local LOGS_MOUNT = "$logs$"
local PLAYLIST_ROW = "[load playlist]"
local KIND_WIRED = "wired"
local KIND_ATEAR = "atear"
local KIND_DIST  = "dist"
local FRAC_MIN   = "min"
local FRAC_FELT  = "felt"
local FRAC_FAR   = "far"
local VIEW_ROOT, VIEW_POOL, VIEW_FSDIR = "root", "pool", "fsdir"
--- Audition modes cycled by the mode steppers: at the channel's own placement band, raw 2D, or fixed metres.
local MODES = {
    { label = "as wired - near",  kind = KIND_WIRED, frac = FRAC_MIN },
    { label = "as wired - felt",  kind = KIND_WIRED, frac = FRAC_FELT },
    { label = "as wired - far",   kind = KIND_WIRED, frac = FRAC_FAR },
    { label = "at-ear (2D)",      kind = KIND_ATEAR },
    { label = "10m",  kind = KIND_DIST, dist = 10 },
    { label = "25m",  kind = KIND_DIST, dist = 25 },
    { label = "50m",  kind = KIND_DIST, dist = 50 },
    { label = "100m", kind = KIND_DIST, dist = 100 },
}
--- Placement for staged families and playlist entries that resolve to no channel: the wind-band values.
local STAGE_MIN, STAGE_MAX, STAGE_HEIGHT = 30, 130, 10
local DEFAULT_MODE = 2

local _channels = nil
local _staged   = nil
local _by_path  = nil
local _view     = VIEW_ROOT
local _row      = nil
local _from_fs  = false
local _fs_dir   = ""
local _mode_i   = DEFAULT_MODE
local _cur      = nil
local _box      = nil
--- RemoveAll on the empty, not-yet-attached list (the first fill) CTDs in CUIScrollView::Clear.
local _built    = false

--- Collect the channels of one resolved ini (what the engine actually plays, DLTX applied).
local function _collect_channels(rel, bed)
    local ini = ini_file(rel)
    if not (ini and ini.section_for_each) then return end
    ini:section_for_each(function(sec)
        if not ini:line_exist(sec, "sounds") then return end
        local pool = {}
        local raw = ini:r_string_ex(sec, "sounds") or ""
        for tok in string_gmatch(raw, "[^,]+") do
            tok = tok:match("^%s*(.-)%s*$")
            if tok ~= "" and tok ~= "ambient\\no_sound" then pool[#pool + 1] = tok end
        end
        _channels[#_channels + 1] = {
            name   = sec,
            pool   = pool,
            min    = ini:r_float_ex(sec, "min_distance") or STAGE_MIN,
            max    = ini:r_float_ex(sec, "max_distance") or STAGE_MAX,
            height = ini:r_float_ex(sec, "height") or 0,
            bed    = bed,
        }
    end)
end

--- Add one channel's pool paths to the reverse index, each keyed lowercase to its channel name.
local function _add_channel_paths(ch)
    for k = 1, #ch.pool do
        local key = ch.pool[k]:lower()
        _by_path[key] = _by_path[key] or {}
        local hit = _by_path[key]
        hit[#hit + 1] = ch.name
    end
end

--- Build the reverse index path -> channel names so a playlist entry plays channel-exact.
local function _build_path_index()
    _by_path = {}
    for i = 1, #_channels do _add_channel_paths(_channels[i]) end
end

local function _build_index()
    _channels = {}
    _collect_channels("environment\\sound_channels.ltx", false)
    _collect_channels("environment\\ambient_channels\\backgrounds.ltx", true)
    table_sort(_channels, function(left, right) return left.name < right.name end)
    _build_path_index()
    _staged = (xfs and xfs.read_folders and xfs.read_folders("$game_sounds$", STAGE_ROOT .. "\\")) or {}
    table_sort(_staged)
end

local function _build_stage_row(name)
    local dir = STAGE_ROOT .. "\\" .. name .. "\\"
    local files = (xfs and xfs.read_files and xfs.read_files("$game_sounds$", dir, ".ogg")) or {}
    table_sort(files)
    local pool = {}
    for i = 1, #files do pool[i] = STAGE_ROOT .. "\\" .. name .. "\\" .. files[i] end
    return { name = STAGE_ROOT .. "/" .. name, pool = pool,
             min = STAGE_MIN, max = STAGE_MAX, height = STAGE_HEIGHT, bed = false }
end

--- The browse rows at root: every channel, then every staged family.
--- The [load playlist] entry is list index 0, so list index i (1-based) maps to rows[i].
local function _get_rows()
    local rows = {}
    for i = 1, #_channels do rows[#rows + 1] = _channels[i] end
    for i = 1, #(_staged or {}) do rows[#rows + 1] = _build_stage_row(_staged[i]) end
    return rows
end

local function _get_tail(path)
    return path:match("([^\\]+)$") or path
end

--- The channel(s) a playlist path belongs to, first match, for channel-exact play.
--- Returns the joined channel names plus that channel's min, max, and height; an unmatched path gets the stage band.
local function _resolve_channel(path)
    local hit = _by_path and _by_path[path:lower()]
    if not hit or #hit == 0 then return nil, STAGE_MIN, STAGE_MAX, STAGE_HEIGHT end
    for i = 1, #_channels do
        if _channels[i].name == hit[1] then
            local ch = _channels[i]
            return table_concat(hit, "+"), ch.min, ch.max, ch.height
        end
    end
    return table_concat(hit, "+"), STAGE_MIN, STAGE_MAX, STAGE_HEIGHT
end

--- The actor position, or nil without an actor (never cache the pointer).
local function _get_actor_position()
    return db.actor and db.actor:position()
end

--- The placement point for a 3D mode: camera-forward at the given distance, lifted by the channel height.
local function _compute_position(dist, height)
    local apos = _get_actor_position()
    if not apos then return nil end
    local dir = device().cam_dir
    local flat = vector():set(dir.x, 0, dir.z)
    if flat:magnitude() < 0.01 then flat = vector():set(0, 0, 1) end
    flat:normalize()
    local pos = vector():set(apos):add(flat:mul(dist))
    pos.y = pos.y + (height or 0)
    return pos
end

--- Append one note line to $logs$/alifeambience_notes.txt (an investigation log; nothing parses it).
local function _write_note(line)
    local base = getFS and getFS():update_path(LOGS_MOUNT, "")
    if not base then return false end
    return xfs.write_file(base .. NOTES_FILE, line .. "\n", true)
end

--- Read a playlist .txt from the logs dir into a POOL row, one sound path per line.
--- Blank lines and ';' comments are skipped and each path is normalized, so a slightly-off line still plays.
local function _load_playlist(name)
    local base = getFS and getFS():update_path(LOGS_MOUNT, "")
    if not base then return nil end
    local rel = _fs_dir:gsub("/", "\\")
    local data = xfs.read_file(base .. rel .. name .. ".txt")
    if not data then return nil end
    local pool = {}
    for line in data:gmatch("[^\r\n]+") do
        local path = line:match("^%s*(.-)%s*$")
        if path ~= "" and path:sub(1, 1) ~= ";" then
            path = path:gsub("/", "\\"):gsub("%.ogg$", "")
            pool[#pool + 1] = path
        end
    end
    return { name = "playlist: " .. name, pool = pool,
             min = STAGE_MIN, max = STAGE_MAX, height = STAGE_HEIGHT, bed = false, playlist = true }
end

--- Open the player when the MCM sound_player toggle allows it (aa_player_wnd resolves at call time).
local function try_open()
    if _box and _box:IsShown() then return end
    if not (db.actor and aa_mcm and aa_mcm.get_config and aa_mcm.get_config("sound_player")) then return end
    _channels = nil
    _box = aa_player_wnd()
    _box:ShowDialog(true)
    Register_UI("aa_player_wnd", "ui_aa_player", _box)
end

class "aa_player_wnd" (CUIScriptWnd)

function aa_player_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    _built = false
    _view, _row, _from_fs, _fs_dir = VIEW_ROOT, nil, false, ""
    if not _channels then _build_index() end
    self:build_list()
    self:update_view()
end

function aa_player_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_aa_player.xml")
    xml:InitStatic("background", self)
    xml:InitStatic("hdr_player", self)
    xml:InitStatic("line_player", self)
    xml:InitStatic("screen", self)
    xml:InitStatic("hdr_verdict", self)
    xml:InitStatic("hdr_snote", self)
    xml:InitFrame("list_frame", self)
    self.list = xml:InitListBox("list", self)
    self.list:ShowSelectedItem(true)
    self:Register(self.list, "list")
    self.lbl_path  = xml:InitStatic("lbl_path", self):TextControl()
    self.lbl_now   = xml:InitStatic("lbl_now", self):TextControl()
    self.lbl_place = xml:InitStatic("lbl_place", self):TextControl()
    self.lbl_loud  = xml:InitStatic("lbl_loud", self):TextControl()
    self.status    = xml:InitStatic("status", self):TextControl()
    self.insp_read = xml:InitStatic("insp_read", self):TextControl()
    self.snote = xml:InitEditBox("snote", self)
    self:Register(self.snote, "snote")
    local buttons = { "btn_pos_down", "btn_pos_up", "btn_prior", "btn_play", "btn_stop", "btn_next",
                      "btn_v1", "btn_v2", "btn_v3", "btn_v4", "btn_v5", "btn_note", "btn_rescan" }
    for i = 1, #buttons do
        self:Register(xml:Init3tButton(buttons[i], self), buttons[i])
    end
end

function aa_player_wnd:init_callbacks()
    self:AddCallback("list",         ui_events.LIST_ITEM_CLICKED, self.select_row,       self)
    self:AddCallback("btn_pos_down", ui_events.BUTTON_CLICKED,    self.select_mode_prior, self)
    self:AddCallback("btn_pos_up",   ui_events.BUTTON_CLICKED,    self.select_mode_next,  self)
    self:AddCallback("btn_prior",    ui_events.BUTTON_CLICKED,    self.select_prior,     self)
    self:AddCallback("btn_play",     ui_events.BUTTON_CLICKED,    self.start_current,    self)
    self:AddCallback("btn_stop",     ui_events.BUTTON_CLICKED,    self.stop_playback,    self)
    self:AddCallback("btn_next",     ui_events.BUTTON_CLICKED,    self.select_next,      self)
    self:AddCallback("btn_v1", ui_events.BUTTON_CLICKED, function() self:add_note("inaudible") end, self)
    self:AddCallback("btn_v2", ui_events.BUTTON_CLICKED, function() self:add_note("faint") end, self)
    self:AddCallback("btn_v3", ui_events.BUTTON_CLICKED, function() self:add_note("loud") end, self)
    self:AddCallback("btn_v4", ui_events.BUTTON_CLICKED, function() self:add_note("unfit") end, self)
    self:AddCallback("btn_v5", ui_events.BUTTON_CLICKED, function() self:add_note("good") end, self)
    self:AddCallback("btn_note",   ui_events.BUTTON_CLICKED, function() self:add_note(nil) end, self)
    self:AddCallback("btn_rescan", ui_events.BUTTON_CLICKED, self.reset_index, self)
end

--- FSDIR list entries in a fixed order: ".." then subfolders then .txt files.
--- The order is fixed so the click index maps back deterministically in select_row.
function aa_player_wnd:read_fs_entries()
    local dir = _fs_dir
    local folders = (xfs and xfs.read_folders and xfs.read_folders(LOGS_MOUNT, dir)) or {}
    local files   = (xfs and xfs.read_files and xfs.read_files(LOGS_MOUNT, dir, ".txt")) or {}
    table_sort(folders)
    table_sort(files)
    return folders, files
end

function aa_player_wnd:build_list()
    if xslice then xslice.stop_queue("aa_player_fill") end
    if _built then self.list:RemoveAll() end
    _built = true
    if _view == VIEW_ROOT then
        self.list:AddTextItem(PLAYLIST_ROW)
        local rows = _get_rows()
        for i = 1, #rows do
            local row = rows[i]
            self.list:AddTextItem(string_format("%s%s  (%d)  %g-%gm",
                row.bed and "[bed] " or "", row.name, #row.pool, row.min, row.max))
        end
    elseif _view == VIEW_FSDIR then
        self.list:AddTextItem("..")
        local folders, files = self:read_fs_entries()
        for i = 1, #folders do self.list:AddTextItem(folders[i] .. "\\") end
        for i = 1, #files do self.list:AddTextItem(files[i]) end
    else
        self:add_pool_rows(_row)
    end
end

--- Fill one row's pool, frame-spread by xslice so xsound.length never builds them all at once.
--- A playlist row also shows each entry's resolved channel, so the sound's context stays visible.
function aa_player_wnd:add_pool_rows(row)
    if not row then return end
    self.list:AddTextItem("..")
    local list = self.list
    local pl = row.playlist
    local function format_label(path)
        local ms = (xsound and xsound.length and xsound.length(path)) or 0
        if pl then
            local ch = _resolve_channel(path)
            return string_format("%s  [%s]  %.1fs", _get_tail(path), ch or "no channel", ms / 1000)
        end
        return string_format("%s    %.1fs", _get_tail(path), ms / 1000)
    end
    if not xslice then
        for i = 1, #row.pool do list:AddTextItem(format_label(row.pool[i])) end
        return
    end
    xslice.start("aa_player_fill", row.pool, { step = 15, func = function(path)
        list:AddTextItem(format_label(path))
        return true
    end })
end

function aa_player_wnd:compute_wired_distance(mode)
    local near = (_cur and _cur.min) or STAGE_MIN
    local far = (_cur and _cur.max) or STAGE_MAX
    if mode.frac == FRAC_MIN then return near end
    if mode.frac == FRAC_FAR then return far * 0.9 end
    return far / 2.0
end

--- The audition mode label; a wired mode appends the distance it resolves to for the loaded sound.
function aa_player_wnd:format_mode()
    local mode = MODES[_mode_i]
    if mode.kind ~= KIND_WIRED or not _cur then return mode.label end
    return string_format("%s (%.0fm, h%g)", mode.label, self:compute_wired_distance(mode), _cur.height or 0)
end

function aa_player_wnd:format_spot()
    local pos = _get_actor_position()
    if not pos then return "no actor" end
    return string_format("%s    pos %.0f %.0f %.0f", level.name(), pos.x, pos.y, pos.z)
end

--- The placement line: the exact settings the current play uses (mode, resolved distance, band, height).
function aa_player_wnd:format_place()
    if not _cur then return "place:  (none)" end
    local mode = MODES[_mode_i]
    local dist = (mode.kind == KIND_DIST) and mode.dist
        or (mode.kind == KIND_WIRED) and self:compute_wired_distance(mode) or 0
    return string_format("place:  %s | %.0fm | band %g-%gm | h%g",
        mode.label, dist, _cur.min or 0, _cur.max or 0, _cur.height or 0)
end

--- The loudness line: measured LUFS and base_volume from the profile, plus the delivered dB at the audition distance.
--- Reads xsound.get_meta and compute_delivered_loudness; a placeholder when no profile is loaded.
function aa_player_wnd:format_loud()
    if not _cur then return "loud:   (none)" end
    local prof = xsound and xsound.get_meta and xsound.get_meta(_cur.path)
    if not prof then return "loud:   -- (no profile; run the pipeline)" end
    local mode = MODES[_mode_i]
    local dist
    if mode.kind ~= KIND_ATEAR then
        dist = (mode.kind == KIND_DIST) and mode.dist or self:compute_wired_distance(mode)
    end
    local eff = xsound.compute_delivered_loudness(prof, dist)
    if not eff then return string_format("loud:   bv %.2f | LUFS --", prof.bv or 1.0) end
    return string_format("loud:   %.1f LUFS | bv %.2f | est. %.0f dB", prof.lufs, prof.bv or 1.0, eff)
end

function aa_player_wnd:update_view()
    if _view == VIEW_ROOT then
        self.lbl_path:SetText(string_format("channels    (%d + %d staged)  -  [load playlist]",
            #(_channels or {}), #(_staged or {})))
        self.status:SetText("click a channel, or [load playlist] to browse the logs dir")
    elseif _view == VIEW_FSDIR then
        self.lbl_path:SetText(string_format("logs\\%s    (browse a .txt playlist)", _fs_dir))
        self.status:SetText("click a folder to open it, a .txt to load it, or .. to go up")
    else
        self.lbl_path:SetText(string_format("%s    (%d)  %g-%gm  h%g",
            _row and _row.name or "?", _row and #_row.pool or 0,
            _row and _row.min or 0, _row and _row.max or 0, _row and _row.height or 0))
        self.status:SetText("click a sound to play    -    click a premade note, or type + add note")
    end
    self.lbl_now:SetText(_cur and ("now:    " .. _cur.channel .. " :: " .. _cur.name)
        or "now:    (none - click a sound)")
    self.lbl_place:SetText(self:format_place())
    self.lbl_loud:SetText(self:format_loud())
    if self.insp_read then self.insp_read:SetText(self:format_spot()) end
end

--- Load a sound into _cur from a row and pool path, resolving its placement band.
--- A playlist entry gets its channel-exact band; a channel or staged entry uses the row's own.
function aa_player_wnd:load_cur(row, path)
    if row.playlist then
        local ch, mn, mx, h = _resolve_channel(path)
        _cur = { channel = ch or "no channel", name = _get_tail(path), path = path, min = mn, max = mx, height = h }
    else
        _cur = { channel = row.name, name = _get_tail(path), path = path,
                 min = row.min, max = row.max, height = row.height }
    end
end

function aa_player_wnd:start_current()
    if not (_cur and xsound) then return end
    local mode = MODES[_mode_i]
    if mode.kind == KIND_ATEAR then
        xsound.play_at(_cur.path, { s2d = true, volume = 1.0 })
        return
    end
    local dist = (mode.kind == KIND_DIST) and mode.dist or self:compute_wired_distance(mode)
    local pos = _compute_position(dist, mode.kind == KIND_WIRED and _cur.height or 0)
    if pos then xsound.play_at(_cur.path, { position = pos }) end
end

function aa_player_wnd:select_row()
    local idx = self.list:GetSelectedIndex()
    if not idx or idx < 0 then return end
    if _view == VIEW_ROOT then self:select_root(idx)
    elseif _view == VIEW_FSDIR then self:select_fsdir(idx)
    else self:select_pool(idx) end
end

--- ROOT click: index 0 opens the logs-dir browser; any other index drills into that row's pool.
function aa_player_wnd:select_root(idx)
    if idx == 0 then
        _view, _fs_dir = VIEW_FSDIR, ""
        self:build_list(); self:update_view()
        return
    end
    local row = _get_rows()[idx]
    if not row then return end
    _row, _from_fs, _view = row, false, VIEW_POOL
    self:build_list(); self:update_view()
end

--- FSDIR click: index 0 goes up (or back to root), a folder descends, a .txt loads as a playlist.
function aa_player_wnd:select_fsdir(idx)
    if idx == 0 then
        if _fs_dir == "" then _view = VIEW_ROOT else _fs_dir = _fs_dir:gsub("[^\\]+\\$", "") end
        self:build_list(); self:update_view()
        return
    end
    local folders, files = self:read_fs_entries()
    if idx <= #folders then
        _fs_dir = _fs_dir .. folders[idx] .. "\\"
        self:build_list(); self:update_view()
        return
    end
    local name = files[idx - #folders]
    local pl = name and _load_playlist(name)
    if not pl then self.status:SetText("could not read playlist: " .. tostring(name)); return end
    _row, _from_fs, _view = pl, true, VIEW_POOL
    self:build_list(); self:update_view()
    self.status:SetText(string_format("loaded playlist %s  (%d entries)", name, #pl.pool))
end

--- POOL click: index 0 returns (to the logs browser if a playlist, else root); any other index plays.
function aa_player_wnd:select_pool(idx)
    if idx == 0 then
        _view = _from_fs and VIEW_FSDIR or VIEW_ROOT
        self:build_list(); self:update_view()
        return
    end
    local path = _row and _row.pool[idx]
    if not path then return end
    self:load_cur(_row, path)
    self:start_current()
    self:update_view()
    self.status:SetText(string_format("playing:  %s :: %s", _cur.channel, _cur.name))
end

function aa_player_wnd:stop_playback()
    if xsound then xsound.stop_shots() end
    self.status:SetText("stopped")
end

--- Mode steppers cycle the audition mode ONLY (they never play - Play/click is the one trigger).
function aa_player_wnd:select_mode_prior()
    _mode_i = _mode_i - 1
    if _mode_i < 1 then _mode_i = #MODES end
    self:update_view()
end

function aa_player_wnd:select_mode_next()
    _mode_i = _mode_i % #MODES + 1
    self:update_view()
end

--- The list index of the currently loaded pool entry, or 1 when none is loaded.
function aa_player_wnd:find_pool_index()
    if not _cur then return 1 end
    for k = 1, #_row.pool do
        if _get_tail(_row.pool[k]) == _cur.name then return k end
    end
    return 1
end

--- Step the selection to a neighbouring pool entry, move only (silent) - Prev/Next never play.
function aa_player_wnd:select_step(delta)
    if _view ~= VIEW_POOL or not (_row and #_row.pool > 0) then return end
    local at = (self:find_pool_index() - 1 + delta) % #_row.pool + 1
    self:load_cur(_row, _row.pool[at])
    self.list:SetSelectedIndex(at)
    self:update_view()
end

function aa_player_wnd:select_prior() self:select_step(-1) end
function aa_player_wnd:select_next()  self:select_step(1) end

--- Write a sound note for the current sound (a premade preset, the typed field, or both combined).
function aa_player_wnd:add_note(premade)
    if not _cur then return end
    local custom = self.snote:GetText()
    local text
    if premade and custom and custom ~= "" then text = premade .. " :: " .. custom
    elseif premade then text = premade
    else text = custom end
    if not text or text == "" then return end
    local apos = _get_actor_position()
    local written = apos and _write_note(string_format(
        "[SOUND] %s  channel=%s  mode=%s  level=%s  pos=%.1f,%.1f,%.1f  :: %s",
        _cur.path, _cur.channel, MODES[_mode_i].label, tostring(level.name()),
        apos.x, apos.y, apos.z, text))
    self.snote:SetText("")
    self.status:SetText(written and string_format("NOTE %s :: %s", _cur.name, text)
        or "note FAILED (no actor?)")
end

--- Re-read the channel config and the stage tree (after a merge.py stage/unstage or a config edit).
function aa_player_wnd:reset_index()
    _build_index()
    _view, _row, _from_fs, _fs_dir = VIEW_ROOT, nil, false, ""
    self:build_list()
    self:update_view()
end

--- Esc closes the window when no edit box has focus; no other shortcut, so game binds are never shadowed.
function aa_player_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if action ~= ui_events.WINDOW_KEY_PRESSED then return res end
    if res or dik ~= DIK_keys.DIK_ESCAPE then return res end
    self:stop_player()
    return true
end

function aa_player_wnd:stop_player()
    if xslice then xslice.stop_queue("aa_player_fill") end
    if xsound then xsound.stop_shots() end
    self:HideDialog()
    Unregister_UI("aa_player_wnd")
end

--- PageUp opens the player. Load the generated per-sound profiles into xsound once, if present.
function on_game_start()
    if aa_sound_metadata and aa_sound_metadata.rows and xsound and xsound.load_meta then
        xsound.load_meta(aa_sound_metadata.rows)
    end
    RegisterScriptCallback("on_key_press", function(key)
        if key == PGUP_KEY then try_open() end
    end)
end
