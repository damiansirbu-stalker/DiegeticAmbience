--- aa_diag: the runtime wiring inspector - logs the active ambient wiring after load and on demand (console: aa_diag.log_wiring()). Debug-only.

local ini_file, parse_list, tostring = ini_file, parse_list, tostring
local RegisterScriptCallback = RegisterScriptCallback

-- The weather-state vocabulary the presets cover (Atmospherics = these 12). Order is the report order.
local WEATHER_STATES = { "day", "morning", "evening", "night", "rain", "rain_day", "rain_night",
                         "storm_day", "storm_night", "tuman", "tuman_night", "indoor_underground" }
local CHANNELS_FILE = "environment\\sound_channels.ltx"

local function _is_enabled()
    return (aa_debug and aa_debug.is_on())
        or (aa_mcm and aa_mcm.get_config and aa_mcm.get_config("diag_ambient"))
end

--- The number of channels a state references that have no definition (a scheduled channel that plays nothing).
local function _get_dangling_count(chans, ini_snd)
    local total = 0
    for i = 1, #chans do
        local defined = ini_snd:section_exist(chans[i])
        if not defined then total = total + 1 end
    end
    return total
end

--- One INFO line per covered state: dynamic channel count, dangling count, ACTIVE marker.
--- INFO not DEBUG, so the diag_ambient toggle prints it whenever on (aa_debug.update floors INFO).
local function _log_states(ini_lvl, ini_snd, active)
    for i = 1, #WEATHER_STATES do
        local st = WEATHER_STATES[i]
        local chans = ini_lvl:section_exist(st) and parse_list(ini_lvl, st, "sound_channels_dynamic")
        if chans then
            aa_debug.info("[DIAG]   %-16s dyn=%d dangling=%d%s",
                st, #chans, _get_dangling_count(chans, ini_snd), (st == active) and "   <== ACTIVE" or "")
        end
    end
end

--- The continuous background layer (System A sound_channels) for the active state.
local function _log_background(ini_lvl, ini_snd, state)
    local chans = ini_lvl:section_exist(state) and parse_list(ini_lvl, state, "sound_channels")
    local first = chans and chans[1]
    if first then
        aa_debug.info("[DIAG] active background: %s (defined=%s)",
            tostring(first), tostring(ini_snd:section_exist(first)))
    end
end

--- Log the active ambient wiring block (console-safe: run_string aa_diag.log_wiring()).
function log_wiring()
    if not (_is_enabled() and level.present() and db.actor) then return end
    local level_name = level.name()
    local weather    = level.get_weather and level.get_weather() or "?"
    local wm         = level_weathers and level_weathers.get_weather_manager()
    local state      = wm and tostring(wm:get_curr_ambient()) or "?"

    aa_debug.info("[DIAG] level=%s weather=%s state=%s", tostring(level_name), tostring(weather), state)

    local ini_lvl = ini_file("environment\\ambients\\" .. level_name .. ".ltx")
    if not ini_lvl then
        aa_debug.warn("[DIAG] no level ambient ltx for %s (background/one-shots will not schedule)", tostring(level_name))
        aa_debug.flush()
        return
    end

    local ini_snd = ini_file(CHANNELS_FILE)
    _log_states(ini_lvl, ini_snd, state)
    _log_background(ini_lvl, ini_snd, state)
    aa_debug.flush()
end

--- One wiring block per save load.
function on_game_start()
    RegisterScriptCallback("actor_on_first_update", log_wiring)
end
